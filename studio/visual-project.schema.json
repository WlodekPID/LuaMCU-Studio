{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://studio.luamcu.pl/schemas/visual-project-v1.json",
  "title": "LuaMCU visual project",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "canvas", "components"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "grid", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 640, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 360, "maximum": 2160 },
        "grid": { "type": "integer", "minimum": 1, "maximum": 100 },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "components": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "x", "y", "width", "height", "z", "props"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "type": {
            "enum": [
              "measurement",
              "alarmLamp",
              "chart",
              "relay",
              "slider",
              "text",
              "button"
            ]
          },
          "x": { "type": "integer", "minimum": 0, "maximum": 3840 },
          "y": { "type": "integer", "minimum": 0, "maximum": 2160 },
          "width": { "type": "integer", "minimum": 40, "maximum": 3840 },
          "height": { "type": "integer", "minimum": 40, "maximum": 2160 },
          "z": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "props": { "type": "object" }
        }
      }
    }
  }
}
